+
+/* --- Fetch-available-models picker: search, bulk selection, row states --- */
+
+.fetchPicker {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.fetchSearch {
+  position: relative;
+  display: flex;
+  align-items: center;
+}
+
+.fetchSearchIcon {
+  position: absolute;
+  left: 8px;
+  color: var(--dsw-alias-label-dimmed);
+  pointer-events: none;
+}
+
+.fetchSearchInput {
+  width: 100%;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: 6px;
+  background: var(--dsw-alias-bg-layer-1);
+  color: var(--dsw-alias-label-primary);
+  font-size: 13px;
+  line-height: 20px;
+  padding: 5px 26px 5px 28px;
+}
+
+.fetchSearchInput:focus {
+  outline: none;
+  border-color: var(--dsw-alias-brand-primary);
+}
+
+.fetchSearchInput::placeholder {
+  color: var(--dsw-alias-label-dimmed);
+}
+
+.fetchSearchClear {
+  position: absolute;
+  right: 4px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+  border: none;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--dsw-alias-label-tertiary);
+  cursor: pointer;
+  padding: 0;
+}
+
+.fetchSearchClear:hover {
+  background: var(--dsw-alias-interactive-bg-hover);
+  color: var(--dsw-alias-label-secondary);
+}
+
+.fetchSelectionBar {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px 12px;
+  min-height: 20px;
+}
+
+.fetchMaster {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 13px;
+  color: var(--dsw-alias-label-secondary);
+  cursor: pointer;
+  user-select: none;
+}
+
+.fetchCount {
+  margin-left: auto;
+  font-size: 12px;
+  color: var(--dsw-alias-label-tertiary);
+  white-space: nowrap;
+}
+
+.fetchNoResults {
+  margin: 0;
+  padding: 10px 8px;
+  font-size: 13px;
+  color: var(--dsw-alias-label-tertiary);
+}
+
+/* Custom checkbox: the native input stays for accessibility, the box is styled. */
+.candidateInput {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  opacity: 0;
+  overflow: hidden;
+}
+
+.candidateBox {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+  border: 1px solid var(--dsw-alias-border-l3);
+  border-radius: 4px;
+  color: var(--dsw-alias-label-primary-foreground);
+  transition: background 120ms ease, border-color 120ms ease, transform 120ms ease;
+}
+
+.candidateBoxChecked {
+  background: var(--dsw-alias-brand-primary);
+  border-color: var(--dsw-alias-brand-primary);
+}
+
+.candidateLabel:hover .candidateBox:not(.candidateBoxChecked) {
+  border-color: var(--dsw-alias-brand-primary);
+}
+
+.candidateInput:focus-visible + .candidateBox {
+  outline: 2px solid var(--dsw-alias-brand-primary);
+  outline-offset: 1px;
+}
+
+.candidateSelected {
+  background: var(--dsw-alias-interactive-bg-hover);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .candidateBox {
+    transition: none;
+  }
+}
